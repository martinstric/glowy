    "Glowy will run in the background. Feel free to close the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيعمل Glowy في الخلفية. يمكنك إغلاق التطبيق بكل اطمئنان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy läuft im Hintergrund weiter. Du kannst die App ruhig schließen."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy will run in the background. Feel free to close the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy seguirá funcionando en segundo plano. Puedes cerrar la app tranquilamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy continuera de fonctionner en arrière-plan. Vous pouvez fermer l’app en toute tranquillité."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy continuera de fonctionner en arrière-plan. Vous pouvez fermer l’app sans crainte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowyはバックグラウンドで動作します。アプリは閉じても大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy는 백그라운드에서 실행됩니다. 앱을 닫아도 괜찮습니다."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy bude bežať na pozadí. Apku môžete pokojne zavrieť."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy会在后台运行，你可以放心关闭App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy會在背景執行，你可以放心關閉App。"
          }
        }
      }
    },
