    "Glow on. Or not. That’s up to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "التوهج أم لا؟ القرار لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lass es leuchten. Oder auch nicht. Ganz wie du willst."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glow on. Or not. That’s up to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Que brille. O no. Tú decides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Que la lumière soit. Ou pas. À vous de choisir."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Que la lumière soit. Ou pas. À vous de choisir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "光らせるのも、消すのも、思いのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜든 끄든, 선택은 자유입니다."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Svieťte. Alebo nie. Je to na vás."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要亮，还是不亮？由你决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要亮，還是不亮？由你決定。"
          }
        }
