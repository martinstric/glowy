    "This removes Glowy and its background helper. Your logo goes back to glowing the way Apple intended." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيؤدي ذلك إلى إزالة Glowy والأداة المساعدة التي تعمل في الخلفية. وسيعود الشعار إلى التوهج كما أرادت Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dadurch werden Glowy und das zugehörige Hilfsprogramm im Hintergrund entfernt. Dein Logo leuchtet dann wieder so, wie Apple es vorgesehen hat."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "This removes Glowy and its background helper. Your logo goes back to glowing the way Apple intended."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminarán Glowy y su proceso auxiliar en segundo plano. El logotipo volverá a brillar tal como Apple lo concibió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette action supprime Glowy et son assistant en arrière-plan. Votre logo brillera de nouveau comme Apple l’a prévu."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette action supprime Glowy et son assistant en arrière-plan. Votre logo brillera de nouveau comme Apple l’a prévu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowyとバックグラウンドヘルパーを削除します。ロゴはAppleが意図したとおりの光り方に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Glowy와 백그라운드 도우미가 삭제됩니다. 로고는 Apple이 의도한 방식대로 다시 빛나게 됩니다."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Týmto sa odstráni Glowy spolu s pomocným procesom na pozadí. Logo bude opäť svietiť tak, ako to zamýšľala spoločnosť Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "这会移除Glowy及其后台辅助程序。标志将恢复为Apple原本设计的发光方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這會移除Glowy及其背景輔助程式。標誌將恢復成Apple原本設計的發光方式。"
          }
        }
      }
    },
