    "Approve Glowy under 'Background App Activity' in Login Items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرجى الموافقة على Glowy ضمن \"نشاط التطبيقات في الخلفية\" في عناصر تسجيل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Genehmige Glowy in den Anmeldeobjekten unter „App-Hintergrundaktivität“."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Approve Glowy under 'Background App Activity' in Login Items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aprueba Glowy en “Actividad de apps en segundo plano” dentro de “Ítems de inicio”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez Glowy sous « Activité des apps en arrière-plan » dans les éléments de connexion."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez Glowy sous « Activité des apps en arrière-plan » dans Éléments d’ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorizza Glowy in “Attività delle app in background” in “Elementi login”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ログイン項目”の“アプリのバックグラウンドアクティビティ”でGlowyを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "로그인 항목의 ‘앱 백그라운드 활동’에서 Glowy를 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keur Glowy in Inlogonderdelen goed onder 'Achtergrondactiviteit van apps'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatwierdź Glowy w sekcji „Aktywność aplikacji w tle” w ustawieniach logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aprove o Glowy em “Atividade de Apps em Segundo Plano” nos Itens de Início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разрешите Glowy в объектах входа в разделе «Фоновая активность приложений»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Povoľte Glowy v sekcii „Aktivita apiek na pozadí“ v Prihlasovacích položkách."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giriş Öğeleri’nde “Uygulama Arka Plan Etkinliği” altında Glowy’yi onaylayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请在“登录项”的“App后台活动”中允许Glowy。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請在「登入項目」的「App背景活動」中允許Glowy。"
          }
        }
      }
