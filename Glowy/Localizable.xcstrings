    "Open Control Center → Edit Controls → find Glowy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "افتح مركز التحكم ← تعديل عناصر التحكم ← ابحث عن Glowy‏."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffne das Kontrollzentrum → „Steuerelemente bearbeiten“ → suche Glowy."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Open Control Centre → Edit Controls → find Glowy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre el centro de control → Editar controles → busca Glowy."
